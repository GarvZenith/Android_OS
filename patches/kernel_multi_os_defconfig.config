# ==============================================================================
# Custom Multi-OS Android Kernel Defconfig Configuration Flags
# Enables: KVM, eBPF Packet Inspection, PRoot/Chroot, Box64/Winlator Memory Mapping
# ==============================================================================

# Virtualization & Container Subsystems
CONFIG_KVM=y
CONFIG_KVM_ARM_HOST=y
CONFIG_VHOST_NET=m
CONFIG_VHOST_CROSS_ENDIAN_LEGACY=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# Memory & Process Management for Box64 / Wine Translation
CONFIG_ARM64_4K_PAGES=y
CONFIG_COMPAT=y
CONFIG_BINFMT_MISC=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_PROCESS_REVMAP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y

# Security & SELinux Permissive Customization
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=0
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_ALWAYS_PERMISSIVE=y

# eBPF Network Packet Filtering & Security Hooking
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
CONFIG_BPF_JIT=y
CONFIG_HAVE_EBPF_JIT=y

# Android Binder IPC & Shared Memory (ASHMEM)
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y

# Direct3D / Mesa / Turnip Adreno GPU Support
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_SCHED=y
